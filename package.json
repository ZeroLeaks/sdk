{
  "name": "@zeroleaks/sdk",
  "version": "0.5.0",
  "description": "Official TypeScript SDK for the ZeroLeaks developer API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "require": "./dist/ai-sdk.cjs"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js",
      "require": "./dist/openai.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/ai-sdk.ts src/openai.ts --format esm,cjs --sourcemap --clean --external ai --external openai --out-dir dist && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "bun run typecheck && bun test",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "bun run test && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeroLeaks/sdk.git"
  },
  "homepage": "https://zeroleaks.ai/docs/sdk",
  "bugs": {
    "url": "https://github.com/ZeroLeaks/sdk/issues"
  },
  "keywords": [
    "ai-security",
    "red-team",
    "prompt-injection",
    "system-prompt",
    "sdk"
  ],
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.102",
    "@types/node": "^26.6.5",
    "ai": "^7.0.153",
    "bun-types": "^1.4.4",
    "openai": "^7.43.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "openai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "0.28.2",
    "undici": "7.30.1"
  }
}
